{
  "mcpServers": {
    "oplane": {
      "type": "streamable-http",
      "url": "https://gravity.oplane.io/mcp/",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "authorizationUrl": "https://gravity.oplane.io/authorize",
            "tokenUrl": "https://gravity.oplane.io/token",
            "registrationUrl": "https://gravity.oplane.io/register"
          }
        }
      }
    }
  }
}
